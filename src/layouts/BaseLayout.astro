---
const { title, description } = Astro.props;
---
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | امیررضا مقدم پور</title>
  
  <style is:global>
    /* ایمپورت فونت وزیرمتن با استراتژی swap برای جلوگیری از خطای CLS در Core Web Vitals */
    @import url('https://cdn.jsdelivr.net/npm/vazirmatn@33.0.3/Vazirmatn-font-face.css');

    :root {
      --bg: #ffffff;
      --text: #1e293b;
      --primary: #2563eb;
      --card-bg: #f9fafb;
      --border: #e2e8f0;
      --muted: #64748b;
    }
    .dark {
      --bg: #0f172a;
      --text: #f8fafc;
      --primary: #3b82f6;
      --card-bg: #1e293b;
      --border: #334155;
      --muted: #94a3b8;
    }
    body {
      background-color: var(--bg);
      color: var(--text);
      /* تنظیم فونت استاندارد */
      font-family: 'Vazirmatn', system-ui, -apple-system, sans-serif;
      transition: background-color 0.3s, color 0.3s;
      margin: 0;
      line-height: 1.8;
    }
    
    .container { max-width: 850px; margin: 0 auto; padding: 0 1.5rem; }
    
    nav {
      display: flex; justify-content: space-between; align-items: center;
      padding: 2rem 0; margin-bottom: 3rem; border-bottom: 1px solid var(--border);
    }
    
    .theme-toggle {
      background: var(--card-bg);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      transition: 0.3s;
      font-weight: bold;
      font-family: inherit;
    }
    .theme-toggle:hover { background-color: var(--border); }
    
    /* استایل‌های حیاتی برای رندر درست خروجی Markdown */
    h1, h2, h3, h4 { color: var(--text); font-weight: 700; margin-top: 2.5rem; margin-bottom: 1rem; }
    p { margin-bottom: 1.5rem; }
    a { color: var(--primary); text-decoration: none; transition: 0.2s; }
    a:hover { text-decoration: underline; }
    ul, ol { padding-inline-start: 1.5rem; margin-bottom: 1.5rem; }
    li { margin-bottom: 0.5rem; }
    blockquote {
      border-inline-start: 4px solid var(--primary);
      padding: 1rem;
      color: var(--text);
      background-color: var(--card-bg);
      margin: 1.5rem 0;
      border-radius: 8px;
    }
    code {
      background-color: var(--card-bg);
      color: var(--primary);
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.9em;
      border: 1px solid var(--border);
      direction: ltr;
    }
    pre {
      background-color: var(--card-bg) !important;
      padding: 1.5rem;
      border-radius: 8px;
      overflow-x: auto;
      border: 1px solid var(--border);
      direction: ltr;
      text-align: left;
      margin: 1.5rem 0;
    }
    pre code {
      background-color: transparent;
      border: none;
      padding: 0;
      color: inherit;
    }
  </style>

  <!-- اجرای اسکریپت تم در هدر برای جلوگیری از Flash of Unstyled Content (FOUC) -->
  <script is:inline>
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      return 'light';
    })();
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body>
  <div class="container">
    <nav>
      <div style="font-size: 1.4rem; font-weight: 800;">
        Amirreza <span style="color: var(--primary);">Moghadampour</span>
      </div>
      <div style="display: flex; gap: 1.5rem; align-items: center;">
        <a href="/">وبلاگ</a>
        <button id="themeToggle" class="theme-toggle">🌓 تغییر حالت</button>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer style="text-align:center; padding:4rem 0; color:var(--muted); border-top:1px solid var(--border); margin-top:4rem;">
      © 2026 امیررضا مقدم پور - متخصص توسعه نرم‌افزار و SEO
    </footer>
  </div>

  <!-- لاجیک دکمه تغییر تم -->
  <script>
    const toggleBtn = document.getElementById("themeToggle");
    toggleBtn.addEventListener("click", () => {
      document.documentElement.classList.toggle("dark");
      const currentTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
      localStorage.setItem("theme", currentTheme);
    });
  </script>
</body>
</html>
