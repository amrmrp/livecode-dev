---
import { getCollection } from "astro:content";
const { category } = Astro.params;
const posts = (await getCollection("blog")).filter(
  (p) => p.data.category === category
);
---

<h1>دسته‌بندی: {category}</h1>

<ul>
  {posts.map((post) => (
    <li>
      <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
    </li>
  ))}
</ul>
