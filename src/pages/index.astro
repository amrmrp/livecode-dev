---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<BaseLayout title="متخصص سئو" description="وبلاگ تخصصی امیررضا مقدم پور">
    <header style="padding: 4rem 0;">
        <h1 style="font-size: 3rem; line-height: 1.2; margin-bottom: 1.5rem;">
            ساخت سیستم‌های <span style="color: var(--primary);">مقیاس‌پذیر</span> و بهینه برای موتورهای جستجو
        </h1>
    <p style="font-size: 1.25rem; color: var(--muted); max-width: 700px;">
    من امیررضا مقدم‌پور هستم؛ مهندس ارشد نرم‌افزار و لید فنی با تمرکز بر طراحی، توسعه و مقیاس‌پذیرسازی سیستم‌های High ‑ Load. 
    تخصص اصلی من ساخت Backendهای Performance ‑محور، معماری تمیز (Clean Architecture)، و تصمیم‌گیری‌های فنی‌ای است که مستقیماً به رشد محصول و کسب‌وکار منجر می‌شوند.
    در کنار توسعه نرم‌افزار، روی اصول SEO تکنیکال و بهینه‌سازی ساختار سیستم‌ها برای افزایش Visibility، سرعت و Conversion تمرکز دارم.
        طراحی سیستم‌های قابل توسعه و حل مسائل پیچیده در مقیاس بالا، بخش اصلی مسیر حرفه‌ای من را تشکیل می‌دهد.
    </p>
    <div style="margin-top: 2.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
  <a
    href="mailto:amir.my.dev@gmail.com"
    style="
      background: var(--primary);
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
    "
  >
    ارتباط مستقیم با من
  </a>
  <a
    href="https://drive.google.com/file/d/1yZlW7tsSq3GdxYPmISdCny-k_QZi0lCy/view?usp=sharing"
    target="_blank"
    rel="noopener"
    style="
      border: 1px solid var(--primary);
      color: var(--primary);
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
    "
  >
    دانلود رزومه (PDF)
  </a>
</div>

    </header>

    <section>
        <h2 style="margin-bottom: 2rem;">مقالات اخیر</h2>
        <div style="display: grid; gap: 1.5rem;">
            {posts.map(post => (
                <article class="glass-card">
                    <small style="color: var(--primary);">{post.data.publishDate}</small>
                    <a href={`/category/${post.data.category}`} style="
                                                                        display: inline-block;
                                                                        background: var(--primary);
                                                                        color: white;
                                                                        font-size: 0.75rem;
                                                                        padding: 0.2rem 0.6rem;
                                                                        border-radius: 20px;
                                                                        margin-right: 0.5rem;
                                                                        text-decoration: none;
                                                                        ">{post.data.category}</a>
                    <h3 style="margin: 0.5rem 0;"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
                    <p style="color: var(--muted); margin-bottom: 1.5rem;">{post.data.description}</p>
                    <a href={`/blog/${post.slug}`} style="font-weight: 600;">ادامه مطلب ←</a>
                </article>
            ))}
        </div>
    </section>
</BaseLayout>
